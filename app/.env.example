# Origin of the FastAPI backend. The client appends /api/v1/... itself, so use
# a bare origin (or a proxy mount prefix, e.g. https://host/api/nba-stock-market).
EXPO_PUBLIC_NBA_STOCK_API_URL=http://127.0.0.1:8011
EXPO_PUBLIC_SUPABASE_URL=https://your-databallr-auth-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-databallr-auth-public-key
# OPTIONAL, PRIVATE SANDBOX ONLY: enables the SeasonControl advance/reset
# controls. Must equal the server's NBA_STOCK_SETTLEMENT_ADMIN_KEY (>=32 chars).
# EXPO_PUBLIC_* values ship readably in the web bundle - never set this against
# a shared or public server.
# EXPO_PUBLIC_NBA_STOCK_SETTLEMENT_KEY=
