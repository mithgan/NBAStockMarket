# Local-only example. Copy values into your shell or hosting environment.
# ApiSettings intentionally does not auto-load .env files.
NBA_STOCK_ENVIRONMENT=development
NBA_STOCK_DATABASE_URL=sqlite+pysqlite:///./nba-stock-market.db
NBA_STOCK_AUTO_CREATE_SCHEMA=true
NBA_STOCK_SEED_FILE=data/generated/market-seed.json
NBA_STOCK_REPLAY_SEED_FILE=data/generated/replay-seed.json

# Required for authenticated endpoints. Use the public project URL/key, never
# a service-role key. The publishable key supports legacy HS256 user tokens.
NBA_STOCK_SUPABASE_URL=
NBA_STOCK_SUPABASE_PUBLISHABLE_KEY=
NBA_STOCK_SUPABASE_JWT_AUDIENCE=authenticated

# Required only by the scheduler/admin settlement route. Use a separate,
# randomly generated secret; never expose it to the Expo client.
NBA_STOCK_SETTLEMENT_ADMIN_KEY=

# Used by the BDL data tools and passed explicitly by the future Flask adapter.
# This API package does not read the key into its live runtime or start a timer.
BALL_DONT_LIE_API_KEY=
NBA_STOCK_LIVE_SETTLEMENT_ENABLED=false
NBA_STOCK_LIVE_RULESET_ID=
NBA_STOCK_LIVE_RULESET_VERSION=
NBA_STOCK_LIVE_RULESET_SEASON_ID=
NBA_STOCK_LIVE_DIVIDEND_DOLLARS_PER_NET_POINT=
NBA_STOCK_LIVE_PROVIDER_SEASON_ID=

# JSON array when provided through the environment.
NBA_STOCK_CORS_ORIGINS='["http://localhost:8081"]'
